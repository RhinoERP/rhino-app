NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-key

# PWA: produccion se habilita por defecto; usar true en previews controladas
NEXT_PUBLIC_PWA_ENABLED=false

# Sentry (crear un proyecto Next.js dedicado a Rhinos)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Secreto de CI usado solamente para subir source maps privados
SENTRY_AUTH_TOKEN=

ARCA_SECRETS_MASTER_KEY=base64-encoded-32-byte-key
AFIP_SDK_ACCESS_TOKEN=tu_access_token_de_afipsdk

RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM_EMAIL=noreply@tudominio.com
RESEND_WEBHOOK_SECRET=whsec_tu_secret_de_webhook

# WhatsApp Cloud API (webhook de Next)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token-aleatorio-de-verificacion
WHATSAPP_META_APP_SECRET=app-secret-de-meta

# Worker Railway
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WHATSAPP_META_ACCESS_TOKEN=token-de-meta-para-mensajes-salientes
